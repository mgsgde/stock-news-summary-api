# Copy to .env and fill in. Never commit .env.

# Port the HTTP server listens on
PORT=3000

# OpenAI API key (required to run the real server)
OPENAI_API_KEY=

# Generator model writes the summary. Reasoning effort: minimal | low | medium | high
GENERATOR_MODEL=gpt-5-mini
GENERATOR_REASONING=low

# Verifier model checks every key point against the articles (independent call)
VERIFIER_MODEL=gpt-5
VERIFIER_REASONING=medium

# Set to false to skip the verifier (cheaper, but key points are returned unchecked)
VERIFY=true

# How long a summary stays in the in-memory cache
CACHE_TTL_MINUTES=30

# How many news articles to fetch per request
NEWS_LIMIT=10

# Articles older than this many days are ignored (the news feed can return weeks-old items)
NEWS_MAX_AGE_DAYS=7

# SQLite file path
DATABASE_PATH=data/app.sqlite
