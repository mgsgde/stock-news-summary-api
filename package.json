{
  "name": "stock-news-summary-api",
  "version": "1.0.0",
  "description": "REST API that returns a verified AI summary of the latest news for a stock",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsoa spec-and-routes && tsc -p tsconfig.build.json",
    "dev": "nodemon",
    "start": "node dist/index.js",
    "test": "tsoa spec-and-routes && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,js,cjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,json,md,yml}\""
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsoa": "^6.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
